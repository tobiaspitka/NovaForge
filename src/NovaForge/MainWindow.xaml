<Window x:Class="NovaForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="NovaForge Beta · Installationsstudio" Width="1380" Height="920" MinWidth="1120" MinHeight="740" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragOver">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#112833" CornerRadius="16" Padding="22,18" Margin="0,0,0,20"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding Editing}"><Button Content="Projekt öffnen" Command="{Binding OpenCommand}"/><Button Content="Projekt speichern" Command="{Binding SaveCommand}"/></StackPanel><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="◈  NovaForge" FontSize="31" FontWeight="Bold"/><Border Background="#FBBF4D" CornerRadius="7" Padding="12,5" Margin="18,0,0,0" VerticalAlignment="Center"><TextBlock Text="BETA STUDIO" Foreground="#35260D" FontWeight="Bold" FontSize="12"/></Border><TextBlock Text="{Binding VersionText}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></StackPanel><TextBlock Text="Software vorbereiten · Schritte aufnehmen · frisch testen · ISO erstellen" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></DockPanel></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#10212B" CornerRadius="14" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Bottom"><Border Background="#3D321C" CornerRadius="8" Padding="12"><TextBlock Text="VORABVERSION&#10;Profile vor produktiver Nutzung prüfen." Foreground="#FFD88A" FontSize="12"/></Border><Button Content="GitHub-Versionen ↗" Command="{Binding ReleasesCommand}" Margin="0,14,0,0"/><Button Content="Lokale Sicherungen" Command="{Binding HistoryCommand}" Margin="0,8,0,0"/></StackPanel><ListBox SelectedIndex="{Binding Tab,Mode=TwoWay}" Background="Transparent" BorderThickness="0"><ListBoxItem Content="01   Windows-Medium"/><ListBoxItem Content="02   Programme"/><ListBoxItem Content="03   Installationsstudio"/><ListBoxItem Content="04   Windows-Setup"/><ListBoxItem Content="05   ISO erstellen"/><ListBoxItem Content="06   Ergebnis"/></ListBox></DockPanel></Border><TabControl Grid.Column="2" SelectedIndex="{Binding Tab}">
   <TabItem Header="01   Windows-ISO"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding Editing}">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ISO oder USB-Stick als Quelle" FontSize="24" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Hint}" Text="Windows 10 / 11 x64 · ISO-Datei oder Stammordner eines entpackten USB-Sticks. Die Quelle wird nur gelesen."/><ComboBox SelectedValue="{Binding SourceKind}" SelectedValuePath="Tag"><ComboBoxItem Content="ISO-Datei" Tag="Iso"/><ComboBoxItem Content="USB-Stick / entpackter Medienordner" Tag="Folder"/></ComboBox><WrapPanel><Button Content="ISO auswählen …" Command="{Binding IsoCommand}"/><Button Content="USB / Medienordner auswählen …" Command="{Binding MediaFolderCommand}"/></WrapPanel><TextBlock Text="Medienquelle"/><DockPanel><TextBox Text="{Binding IsoPath,UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Style="{StaticResource Hint}" Text="{Binding IsoHint}"/><TextBlock Style="{StaticResource Hint}" Text="Editionen, install.wim, install.esd und geteilte install.swm bleiben erhalten. Bei neuen Anpassungen werden vorhandene Antwortdateien oder OEM-Anpassungen als Konflikt gemeldet."/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Microsoft Deployment Tools" FontSize="20"/><TextBlock Style="{StaticResource Hint}" Text="Für die bootfähige Ausgabe benötigt NovaForge oscdimg.exe aus dem kostenlosen Windows ADK. Das Werkzeug wird aus Lizenzgründen nicht mitgeliefert. Im ADK genügt die Auswahl „Deployment Tools“."/><DockPanel><Button DockPanel.Dock="Right" Content="oscdimg auswählen" Command="{Binding ToolCommand}"/><TextBox Text="{Binding OscdimgPath,UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Style="{StaticResource Hint}" Text="{Binding ToolHint}"/><Button Content="Offizielle ADK-Anleitung öffnen ↗" HorizontalAlignment="Left" Command="{Binding AdkCommand}"/></StackPanel></Border>
    <TextBlock Style="{StaticResource Hint}" Text="USB → ISO ist auch ohne zusätzliche Programme oder Setup-Schalter möglich. Vorhandene Anpassungen werden dann erhalten. Für neue Anpassungen ein unverändertes Windows-Medium verwenden. Ventoy- und reine Wiederherstellungssticks werden nicht unterstützt."/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="02   Programme"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#102530" CornerRadius="14" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Deine Software" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding ReadySummary}" Style="{StaticResource Hint}"/><Button Content="＋ Software hinzufügen" Command="{Binding AddCommand}" Margin="0,0,0,14"/></StackPanel><WrapPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><Button Content="↑" Command="{Binding UpCommand}"/><Button Content="↓" Command="{Binding DownCommand}"/><Button Content="Entfernen" Command="{Binding RemoveCommand}"/></WrapPanel><ListBox ItemsSource="{Binding Programs}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding WorkflowStatus}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/><CheckBox Content="In die ISO aufnehmen" IsChecked="{Binding Enabled}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Background="#143642" CornerRadius="14" Padding="24" Margin="0,0,0,16"><StackPanel><TextBlock Text="AKTUELLES PROGRAMM" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding CurrentProgramName}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock Text="{Binding CurrentProgramInfo}" Foreground="{StaticResource Muted}"/><Button Content="Dieses Programm Schritt für Schritt vorbereiten →" Command="{Binding StudioCommand}" HorizontalAlignment="Left" Background="{StaticResource Accent}" Margin="0,18,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" DataContext="{Binding Selected}"><StackPanel IsEnabled="{Binding DataContext.HasSelection,RelativeSource={RelativeSource AncestorType=Window}}"><TextBlock Text="1 · Programm vorbereiten" FontSize="21" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Hint}" Text="Der Name erscheint im Assistenten und auf der späteren ISO. Jede aktive Software braucht eine Aufnahme und einen frischen Test."/><TextBlock Text="Programmname"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Installerdatei"/><TextBox Text="{Binding Path,Mode=OneWay}" IsReadOnly="True"/><Button Content="Andere Installerdatei wählen …" Command="{Binding DataContext.RelinkCommand,RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left"/>
      <Expander Header="Treiber und zusätzliche Installerdateien"><StackPanel><TextBlock Style="{StaticResource Hint}" Text="Falls das Setup weitere Dateien benötigt: seinen Ordner wählen. Dateien und Unterordner werden vollständig übernommen."/><TextBox Text="{Binding CompanionDirectory,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Begleitordner auswählen …" Command="{Binding DataContext.CompanionFolderCommand,RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left"/></StackPanel></Expander>
      <TextBlock Text="Zugeordnete Aufnahme"/><TextBox AutomationProperties.AutomationId="AssignedRecordingName" Text="{Binding RecordingLabel,Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="{Binding WorkflowStatus}" Foreground="{StaticResource Accent}"/><Expander Header="Dateipfad der Aufnahme anzeigen"><TextBox Text="{Binding RecordedProfilePath,Mode=OneWay}" IsReadOnly="True" FontSize="11"/></Expander>
      <Expander Header="Weitere Einstellungen"><StackPanel><CheckBox Content="Webinstaller benötigt Internet" IsChecked="{Binding WebInstaller}"/><TextBlock Text="Zeitlimit in Sekunden"/><TextBox Text="{Binding TimeoutSeconds,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}"/><TextBlock Text="Erlaubte Exitcodes"/><TextBox Text="{Binding AllowedExitCodes,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Bei erforderlichem Neustart"/><ComboBox SelectedValue="{Binding RebootPolicy}" SelectedValuePath="Tag"><ComboBoxItem Content="Bis zu manuellem Neustart pausieren" Tag="PauseUntilReboot"/><ComboBoxItem Content="Fortsetzen; Neustart später" Tag="Continue"/></ComboBox><Button Content="Abhängigkeiten auswählen …" Command="{Binding DataContext.DependenciesCommand,RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left"/><TextBox Text="{Binding Dependencies,Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="SHA-256 des Installers"/><TextBox Text="{Binding Sha256,Mode=OneWay}" IsReadOnly="True" FontSize="11"/></StackPanel></Expander>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="Installationsstudio"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Background="#143642" CornerRadius="14" Padding="24" Margin="0,0,0,16"><DockPanel><Border DockPanel.Dock="Right" Background="#1C4B43" CornerRadius="8" Padding="12,8" VerticalAlignment="Top"><TextBlock Text="{Binding ReadySummary}" Foreground="#92E6C4" FontWeight="SemiBold"/></Border><StackPanel><TextBlock Text="DEIN INSTALLATIONSASSISTENT" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding CurrentProgramName}" FontSize="29" FontWeight="SemiBold" Margin="0,9,0,6"/><TextBlock Text="{Binding CurrentProgramInfo}" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel></Border>
    <UniformGrid Columns="4" Margin="0,0,0,18"><Border Style="{StaticResource StepCard}"><StackPanel><TextBlock Text="01" FontSize="25" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding InstallStepText}" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource StepCard}"><StackPanel><TextBlock Text="02" FontSize="25" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding SaveStepText}" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource StepCard}"><StackPanel><TextBlock Text="03" FontSize="25" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding TestStepText}" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource StepCard}" Margin="0,0,0,0"><StackPanel><TextBlock Text="04" FontSize="25" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding ReleaseStepText}" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Nächster Schritt" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding WizardHint}" Foreground="{StaticResource Muted}" Margin="0,10,0,18"/><WrapPanel Margin="0,10,0,0"><Button Content="{Binding WizardAction}" Command="{Binding WizardCommand}" Background="{StaticResource Accent}" Padding="22,12"/><Button Content="Nächstes Programm →" Command="{Binding NextProgramCommand}"/></WrapPanel><TextBlock Text="Programm auswählen" Margin="0,18,0,0"/><ListBox ItemsSource="{Binding Programs}" SelectedItem="{Binding Selected}" Height="130"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding WorkflowStatus}" Foreground="{StaticResource Accent}" Margin="14,0,0,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Name deiner Aufnahme" Margin="0,16,0,0"/><TextBox Text="{Binding RecordingName,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanRecord}"/><Border Background="#0D202C" CornerRadius="9" Padding="14" Margin="0,18,0,0"><TextBlock Text="{Binding RecorderStatus}"/></Border></StackPanel></Border>
    <Expander Header="Aufnahme wiederholen oder vorhandenes Profil verwenden"><WrapPanel Margin="12"><Button Content="Neue Aufnahme" Command="{Binding RecordCommand}"/><Button Content="Frischer Test" Command="{Binding TestRecordingCommand}"/><Button Content="Profil importieren …" Command="{Binding ImportRecordingCommand}"/><Button Content="Sitzungsordner öffnen" Command="{Binding SessionFolderCommand}"/></WrapPanel></Expander>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows Sandbox" FontSize="20"/><TextBlock Text="{Binding SandboxStatus}" Style="{StaticResource Hint}"/><Button Content="Windows Sandbox aktivieren" Command="{Binding ActivateSandboxCommand}" HorizontalAlignment="Left"/><TextBlock Style="{StaticResource Hint}" Text="Installationsaufnahme und Test laufen mit Administratorrechten. Für den Test muss die erste Sandbox geschlossen sein. UAC auf dem geschützten Desktop bleibt manuell."/></StackPanel></Border>
    <Expander Header="Meine gespeicherten Aufnahmen"><StackPanel Margin="12"><ListBox ItemsSource="{Binding Recordings}" SelectedItem="{Binding SelectedRecording}" Height="170"/><WrapPanel Margin="0,12,0,0"><Button Content="Dem Programm zuordnen" Command="{Binding UseRecordingCommand}"/><Button Content="Name / Prüfdatei bearbeiten" Command="{Binding EditRecordingCommand}"/><Button Content="Exportieren …" Command="{Binding ExportRecordingCommand}"/><Button Content="Bibliothek öffnen" Command="{Binding LibraryFolderCommand}"/></WrapPanel></StackPanel></Expander>
    <TextBlock Style="{StaticResource Hint}" Text="Vertrauliche Werte sind im Profil und auf dem Medium im Klartext enthalten. Hardwareabhängige Treiber können in Sandbox scheitern. Erst ein unveränderter, erfolgreich getesteter Ablauf wird für die ISO freigegeben."/>
   </StackPanel></ScrollViewer></TabItem><TabItem Header="04   Setup-Optionen"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding Editing}">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows nach deinen Vorgaben" FontSize="24" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Hint}" Text="Alle Schalter sind optional und werden nur in der neuen ISO wirksam. Die Einstellungen des Erstellungscomputers werden nicht geändert."/>
     <CheckBox Content="Lokalen Benutzer erstellen · ohne Microsoft-Konto" IsChecked="{Binding Setup.CreateLocalUser}"/><StackPanel IsEnabled="{Binding Setup.CreateLocalUser}"><TextBlock Text="Kontoname"/><TextBox Text="{Binding Setup.LocalUserName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Kennwort (mindestens 8 Zeichen)"/><PasswordBox PasswordChanged="LocalPasswordChanged" Background="#0E1628" Foreground="White" BorderBrush="#334361" Padding="10" Margin="0,5,0,10"/><CheckBox Content="Dieses Konto als Administrator anlegen" IsChecked="{Binding Setup.LocalUserAdministrator}"/><TextBlock Style="{StaticResource Hint}" Text="Kennwörter bleiben nur im Arbeitsspeicher und müssen beim Öffnen eines Projekts neu eingegeben werden. Windows benötigt das Kennwort in der ISO-Antwortdatei; Base64 schützt es nicht vor Auslesen. ISO entsprechend vertraulich behandeln. Es wird kein automatisches Login eingerichtet."/></StackPanel>
     <CheckBox Content="„Ich habe kein Internet“ ermöglichen · buildabhängig" IsChecked="{Binding Setup.EnableOfflineButton}"/><TextBlock Style="{StaticResource Hint}" Text="Setzt BypassNRO vor OOBE. Je nach Windows-11-Build kann der Schalter wirkungslos sein, da Microsoft diese Mechanismen entfernt. Ein vorkonfiguriertes lokales Konto nutzt zusätzlich die dokumentierte Antwortdatei. Kein vorgetäuschter Erfolg und keine Garantie für alle Builds."/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows-11-Setupprüfungen" FontSize="20"/><CheckBox Content="TPM-2.0-Prüfung überspringen" IsChecked="{Binding Setup.BypassTpmCheck}"/><CheckBox Content="Secure-Boot-Prüfung überspringen" IsChecked="{Binding Setup.BypassSecureBootCheck}"/><CheckBox Content="Arbeitsspeicherprüfung überspringen" IsChecked="{Binding Setup.BypassRamCheck}"/><TextBlock Style="{StaticResource Hint}" Text="Experimentelle LabConfig-Schalter im Windows-PE-Setup. Sie schalten weder Firmware-Secure-Boot noch Defender ab. CPU-Instruktionsanforderungen wie SSE4.2/POPCNT bleiben bestehen. Microsoft unterstützt Installationen auf ungeeigneter Hardware nicht; mit der jeweiligen ISO in einer VM prüfen."/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Weitere Einrichtung" FontSize="20"/><TextBlock Text="Computername (optional, höchstens 15 Zeichen)" Margin="0,12,0,0"/><TextBox Text="{Binding Setup.ComputerName,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Region und Tastatur vorgeben" IsChecked="{Binding Setup.ConfigureRegion}"/><ComboBox IsEnabled="{Binding Setup.ConfigureRegion}" SelectedValue="{Binding Setup.Region}" SelectedValuePath="Tag"><ComboBoxItem Content="Deutschland · deutsche Tastatur" Tag="de-DE"/><ComboBoxItem Content="Österreich · deutsche Tastatur" Tag="de-AT"/><ComboBoxItem Content="USA · US-Tastatur" Tag="en-US"/></ComboBox><TextBlock Style="{StaticResource Hint}" Text="Ändert die Regionalformate und Tastatur. Die Anzeigesprache der Original-ISO bleibt erhalten; es werden keine Sprachpakete heruntergeladen."/><CheckBox Content="Zeitzone vorgeben" IsChecked="{Binding Setup.ConfigureTimeZone}"/><ComboBox IsEnabled="{Binding Setup.ConfigureTimeZone}" SelectedValue="{Binding Setup.TimeZone}" SelectedValuePath="Tag"><ComboBoxItem Content="Wien / Berlin" Tag="W. Europe Standard Time"/><ComboBoxItem Content="London" Tag="GMT Standard Time"/><ComboBoxItem Content="UTC" Tag="UTC"/><ComboBoxItem Content="New York" Tag="Eastern Standard Time"/></ComboBox><CheckBox Content="OEM-Registrierungsseite überspringen" IsChecked="{Binding Setup.HideOemRegistration}"/><CheckBox Content="Lange Windows-Dateipfade aktivieren" IsChecked="{Binding Setup.EnableLongPaths}"/><TextBlock Style="{StaticResource Hint}" Text="Lange Pfade gelten für Anwendungen, die Windows-Langpfade unterstützen. Keine Änderungen an Windows Update, Aktivierung oder Schutzsoftware."/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Versionen und Downloads" FontSize="20"/><TextBlock Style="{StaticResource Hint}" Text="Nach erfolgreichem Build, Prozess-/UI-Test und EXE-Start wird jede Entwicklungsversion mit Quellcode, EXE und SHA-256 lokal unter %LOCALAPPDATA%\NovaForge\Versions gesichert. Vorherige Versionen bleiben erhalten. ISO-/VM-Abnahme wird getrennt ausgewiesen."/><StackPanel Orientation="Horizontal"><Button Content="Lokale Versionsstände öffnen" Command="{Binding HistoryCommand}"/><Button Content="GitHub-Versionen herunterladen ↗" Command="{Binding ReleasesCommand}"/></StackPanel></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="05   Erstellung"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ein neues Medium erstellen" FontSize="24"/><TextBlock Text="{Binding ReadySummary}" Foreground="{StaticResource Accent}" Margin="0,8,0,8"/><TextBlock Style="{StaticResource Hint}" Text="Die Erstellung ist erst möglich, wenn alle aktiven Programme eine vollständige Aufnahme und einen frischen Test haben."/><StackPanel IsEnabled="{Binding Editing}"><TextBlock Text="Ausgabe-ISO" Margin="0,16,0,0"/><DockPanel><Button DockPanel.Dock="Right" Content="Ziel auswählen …" Command="{Binding OutputCommand}"/><TextBox Text="{Binding OutputPath,UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Style="{StaticResource Hint}" Text="{Binding OutputHint}"/><TextBlock Text="Arbeitsverzeichnis"/><DockPanel><Button DockPanel.Dock="Right" Content="Ordner auswählen …" Command="{Binding WorkCommand}"/><TextBox Text="{Binding WorkDirectory,UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Style="{StaticResource Hint}" Text="Ausreichend Platz für ISO-Kopie, Installer und neue ISO einplanen. Bestehende Ausgaben werden nicht überschrieben. Administratorfreigaben gelten nur für das Einbinden/Kopieren und Prüfen der ISO."/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="◈  ISO erstellen" Background="{StaticResource Accent}" Command="{Binding BuildCommand}"/><Button Content="Abbrechen" Command="{Binding CancelCommand}"/><Button Content="Konfiguration prüfen" Command="{Binding ValidateCommand}"/></StackPanel></StackPanel></Border><TextBlock Text="{Binding Activity}" FontWeight="SemiBold" Margin="0,0,0,10"/><ProgressBar Height="8" Minimum="0" Maximum="1" Value="{Binding Fraction}" IsIndeterminate="{Binding Indeterminate}"/><TextBox Text="{Binding Log}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Height="270" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="06   Ergebnis"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding ResultTitle}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding ResultText}" Margin="0,20,0,20"/><TextBlock Text="SHA-256"/><TextBox Text="{Binding ResultHash,Mode=OneWay}" IsReadOnly="True"/><StackPanel Orientation="Horizontal"><Button Content="Ausgabeordner öffnen" Command="{Binding FolderCommand}"/><Button Content="Protokoll öffnen" Command="{Binding LogCommand}"/></StackPanel><TextBlock Style="{StaticResource Hint}" Margin="0,24,0,0" Text="Vor produktiver Nutzung in einer VM testen. Systemprotokolle: C:\Windows\NovaForge\State. Benutzerprotokolle: %LOCALAPPDATA%\NovaForge. Ein erforderlicher Neustart muss nach Setup manuell durchgeführt werden."/></StackPanel></Border></ScrollViewer></TabItem>
  </TabControl></Grid><Border Grid.Row="2" Background="#122B37" CornerRadius="10" Padding="14" Margin="0,18,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="EXPERIMENTELL · BETA" Foreground="#FFD88A" Margin="20,0,0,0"/><TextBlock Text="{Binding Status}"/></DockPanel></Border></Grid></Window>