<Window x:Class="NovaForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="NovaForge Beta · Installationsstudio" Width="1380" Height="920" MinWidth="1120" MinHeight="740" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragOver">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#112833" CornerRadius="16" Padding="22,18" Margin="0,0,0,20"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding Editing}"><Button Content="Projekt öffnen" Command="{Binding OpenCommand}"/><Button Content="Projekt speichern" Command="{Binding SaveCommand}"/></StackPanel><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="◈  NovaForge" FontSize="31" FontWeight="Bold"/><Border Background="#FBBF4D" CornerRadius="7" Padding="12,5" Margin="18,0,0,0" VerticalAlignment="Center"><TextBlock Text="BETA STUDIO" Foreground="#35260D" FontWeight="Bold" FontSize="12"/></Border><TextBlock Text="{Binding VersionText}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></StackPanel><TextBlock Text="Medien gestalten · Installation vormachen · kontrolliert wiederholen" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></DockPanel></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#10212B" CornerRadius="14" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Bottom"><Border Background="#3D321C" CornerRadius="8" Padding="12"><TextBlock Text="VORABVERSION&#10;Profile vor produktiver Nutzung prüfen." Foreground="#FFD88A" FontSize="12"/></Border><Button Content="GitHub-Versionen ↗" Command="{Binding ReleasesCommand}" Margin="0,14,0,0"/><Button Content="Lokale Sicherungen" Command="{Binding HistoryCommand}" Margin="0,8,0,0"/></StackPanel><ListBox SelectedIndex="{Binding Tab,Mode=TwoWay}" Background="Transparent" BorderThickness="0"><ListBoxItem Content="01   Windows-Medium"/><ListBoxItem Content="02   Programme"/><ListBoxItem Content="03   Installationsstudio"/><ListBoxItem Content="04   Windows-Setup"/><ListBoxItem Content="05   ISO erstellen"/><ListBoxItem Content="06   Ergebnis"/></ListBox></DockPanel></Border><TabControl Grid.Column="2" SelectedIndex="{Binding Tab}">
   <TabItem Header="01   Windows-ISO"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding Editing}">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ISO oder USB-Stick als Quelle" FontSize="24" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Hint}" Text="Windows 10 / 11 x64 · ISO-Datei oder Stammordner eines entpackten USB-Sticks. Die Quelle wird nur gelesen."/><ComboBox SelectedValue="{Binding SourceKind}" SelectedValuePath="Tag"><ComboBoxItem Content="ISO-Datei" Tag="Iso"/><ComboBoxItem Content="USB-Stick / entpackter Medienordner" Tag="Folder"/></ComboBox><WrapPanel><Button Content="ISO auswählen …" Command="{Binding IsoCommand}"/><Button Content="USB / Medienordner auswählen …" Command="{Binding MediaFolderCommand}"/></WrapPanel><TextBlock Text="Medienquelle"/><DockPanel><TextBox Text="{Binding IsoPath,UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Style="{StaticResource Hint}" Text="{Binding IsoHint}"/><TextBlock Style="{StaticResource Hint}" Text="Editionen, install.wim, install.esd und geteilte install.swm bleiben erhalten. Bei neuen Anpassungen werden vorhandene Antwortdateien oder OEM-Anpassungen als Konflikt gemeldet."/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Microsoft Deployment Tools" FontSize="20"/><TextBlock Style="{StaticResource Hint}" Text="Für die bootfähige Ausgabe benötigt NovaForge oscdimg.exe aus dem kostenlosen Windows ADK. Das Werkzeug wird aus Lizenzgründen nicht mitgeliefert. Im ADK genügt die Auswahl „Deployment Tools“."/><DockPanel><Button DockPanel.Dock="Right" Content="oscdimg auswählen" Command="{Binding ToolCommand}"/><TextBox Text="{Binding OscdimgPath,UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Style="{StaticResource Hint}" Text="{Binding ToolHint}"/><Button Content="Offizielle ADK-Anleitung öffnen ↗" HorizontalAlignment="Left" Command="{Binding AdkCommand}"/></StackPanel></Border>
    <TextBlock Style="{StaticResource Hint}" Text="USB → ISO ist auch ohne zusätzliche Programme oder Setup-Schalter möglich. Vorhandene Anpassungen werden dann erhalten. Für neue Anpassungen ein unverändertes Windows-Medium verwenden. Ventoy- und reine Wiederherstellungssticks werden nicht unterstützt."/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="02   Programme"><Grid IsEnabled="{Binding Editing}"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel><StackPanel DockPanel.Dock="Top"><Button Content="＋ Installer hinzufügen" Command="{Binding AddCommand}" Margin="0,0,0,12"/><TextBlock Style="{StaticResource Hint}" Text="MSI und EXE hierher ziehen. Listenreihenfolge wird unter Berücksichtigung der Abhängigkeiten verwendet."/></StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="↑" Command="{Binding UpCommand}"/><Button Content="↓" Command="{Binding DownCommand}"/><Button Content="Entfernen" Command="{Binding RemoveCommand}"/></StackPanel><ListBox ItemsSource="{Binding Programs}" SelectedItem="{Binding Selected}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Type}" Foreground="{StaticResource Muted}"/><TextBlock Text=" · " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ContextLabel}" Foreground="{StaticResource Muted}"/><CheckBox Content="Aktiv" IsChecked="{Binding Enabled}" Margin="15,0,0,0"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" DataContext="{Binding Selected}"><StackPanel IsEnabled="{Binding DataContext.HasSelection,RelativeSource={RelativeSource AncestorType=Window}}"><TextBlock Text="Installation konfigurieren" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Anzeigename" Margin="0,18,0,0"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Installationsdatei"/><TextBox Text="{Binding Path}" IsReadOnly="True"/><Button Content="Datei neu zuordnen …" Command="{Binding DataContext.RelinkCommand,RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left"/><TextBlock Text="Begleitordner (optional: Treiber und weitere Installerdateien)"/><TextBox Text="{Binding CompanionDirectory,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Installer-/Treiberordner wählen …" Command="{Binding DataContext.CompanionFolderCommand,RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left"/><TextBlock Style="{StaticResource Hint}" Text="Den Ordner mit der Installerdatei wählen. Alle enthaltenen Dateien und Unterordner werden in Sandbox und ISO übernommen. Originaldateiname bleibt erhalten."/><TextBlock Text="Installationsmodus" Margin="0,14,0,0"/><ComboBox SelectedValue="{Binding AutomationMode}" SelectedValuePath="Tag"><ComboBoxItem Content="Stille Installation" Tag="Silent"/><ComboBoxItem Content="Aufgezeichnete Fensterbedienung · Beta" Tag="Recorded"/></ComboBox><TextBlock Text="Recorder-Profil (Import im Installationsstudio)"/><TextBox Text="{Binding RecordedProfilePath}" IsReadOnly="True"/><TextBlock Style="{StaticResource Hint}" Text="Aufzeichnungen benötigen ein unverändertes, frisch getestetes Profil und den Benutzerkontext. Silent-Parameter bleiben die erste Wahl."/><TextBlock Text="Silent-Profil" Margin="0,18,0,0"/><ComboBox ItemsSource="{Binding DataContext.Profiles,RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Profile}" SelectionChanged="ProfileChanged"/><TextBlock Text="Parameter (direkt an den Installer, keine Shell)"/><TextBox Text="{Binding Arguments,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Style="{StaticResource Hint}" Text="MSI: /qn /norestart REBOOT=ReallySuppress und /L*v werden automatisch ergänzt. EXE: Profile sind Vorschläge; Herstellerdokumentation und Neustartunterdrückung prüfen."/>
     <CheckBox Content="Silent-Parameter und Kontext geprüft / bestätigt" IsChecked="{Binding Verified}"/><CheckBox Content="Webinstaller: benötigt Internet auf dem Zielcomputer" IsChecked="{Binding WebInstaller}"/>
     <TextBlock Text="Installationskontext"/><ComboBox SelectedValue="{Binding Context}" SelectedValuePath="Tag"><ComboBoxItem Content="Systemweit · specialize / SYSTEM" Tag="System"/><ComboBoxItem Content="Benutzerbezogen · erste Anmeldung" Tag="User"/></ComboBox><TextBlock Style="{StaticResource Hint}" Text="Benutzerprogramme laufen ohne Erhöhung im angemeldeten Konto. Installer muss diesen Kontext unterstützen. Systeminstaller müssen ohne Desktop funktionieren. Benutzerinstallation ist für das zuerst erfolgreich angemeldete Konto vorgesehen."/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Zeitlimit (Sekunden)"/><TextBox Text="{Binding TimeoutSeconds,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Erlaubte Exitcodes"/><TextBox Text="{Binding AllowedExitCodes,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
     <TextBlock Text="Bei Exitcode 3010 (Neustart erforderlich)"/><ComboBox SelectedValue="{Binding RebootPolicy}" SelectedValuePath="Tag"><ComboBoxItem Content="Bis zu manuellem Neustart pausieren" Tag="PauseUntilReboot"/><ComboBoxItem Content="Fortsetzen; Neustart später manuell" Tag="Continue"/></ComboBox><TextBlock Style="{StaticResource Hint}" Text="NovaForge startet Windows nie während Setup neu. Exitcode 1641 wird als unerwarteter Neustart behandelt. Fehlgeschlagene Installationen und deren abhängige Programme werden protokolliert."/>
     <Button Content="Abhängigkeiten auswählen …" HorizontalAlignment="Left" Command="{Binding DataContext.DependenciesCommand,RelativeSource={RelativeSource AncestorType=Window}}"/><TextBox Text="{Binding Dependencies}" IsReadOnly="True" ToolTip="Stabile Programm-IDs, im Projektmanifest gespeichert"/><TextBlock Text="SHA-256"/><TextBox Text="{Binding Sha256}" IsReadOnly="True" FontSize="11"/>
    </StackPanel></Border></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="Installationsstudio"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding Editing}">
<Border Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Installation einmal vormachen" FontSize="25" FontWeight="SemiBold"/><Border Background="#66451A" CornerRadius="6" Padding="10,4" Margin="18,0,0,0"><TextBlock Text="BETA" Foreground="#FFD88A" FontWeight="Bold"/></Border></StackPanel><TextBlock Style="{StaticResource Hint}" Text="Der Recorder beobachtet Installerfenster in Windows Sandbox und speichert bedienbare Steuerelemente. Kein Installer wird auf dem Erstellungscomputer ausgeführt."/><TextBlock Text="Name meiner Aufnahme"/><TextBox Text="{Binding RecordingName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Programm für die Aufnahme"/><ListBox ItemsSource="{Binding Programs}" SelectedItem="{Binding Selected}" Height="120"/><TextBlock Style="{StaticResource Hint}" Text="Aufnahme und Wiedergabe laufen immer mit Administratorrechten. UAC auf dem geschützten Desktop muss manuell bestätigt werden."/><TextBlock Style="{StaticResource Hint}" Text="{Binding SandboxStatus}"/><Button Content="Windows Sandbox aktivieren" Command="{Binding ActivateSandboxCommand}" HorizontalAlignment="Left"/><WrapPanel><Button Content="01  Installation vormachen" Command="{Binding RecordCommand}" Background="{StaticResource Accent}"/><Button Content="Profil von Datei importieren" Command="{Binding ImportRecordingCommand}"/><Button Content="02  Aufnahme frisch testen" Command="{Binding TestRecordingCommand}"/></WrapPanel><TextBlock Text="{Binding RecorderStatus}" Margin="0,18,0,14"/><Button Content="Sitzungsordner öffnen" HorizontalAlignment="Left" Command="{Binding SessionFolderCommand}"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Vom Klick zum geprüften Profil" FontSize="20"/><TextBlock Style="{StaticResource Hint}" Text="1. In der Sandbox den Installer starten und normal bedienen. Unterstützte Buttons, Checkboxen und Auswahlfelder werden erfasst. Textfelder mit F8 aufnehmen. Lizenzschlüssel und Kennwörter mit F9 ausdrücklich eingeben. Zusatzfenster (z. B. Treiber) über „Installerfenster verbinden“ hinzufügen."/><TextBlock Style="{StaticResource Hint}" Text="2. Eine neu installierte Programmdatei als Prüfnachweis wählen und „Speichern und schließen“ drücken. NovaForge speichert die Aufnahme automatisch in der Bibliothek und ordnet sie dem passenden Installer zu."/><TextBlock Style="{StaticResource Hint}" Text="3. „Aufnahme frisch testen“ drücken. Das erfolgreiche Profil wird automatisch übernommen. Nach dem Schließen werden große Sitzungskopien entfernt. Änderungen erfordern einen neuen Test."/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Meine Aufnahmen" FontSize="22"/><TextBlock Style="{StaticResource Hint}" Text="Aufnahmen bleiben unabhängig vom temporären Sandbox-Ordner erhalten. Oben das Programm, hier die Aufnahme auswählen. Geprüfte Aufnahmen können direkt für die ISO genutzt werden."/><ListBox ItemsSource="{Binding Recordings}" SelectedItem="{Binding SelectedRecording}" Height="150"/><WrapPanel><Button Content="Ausgewählte Aufnahme nutzen" Command="{Binding UseRecordingCommand}"/><Button Content="Name / Prüfdatei bearbeiten" Command="{Binding EditRecordingCommand}"/><Button Content="Aufnahme exportieren …" Command="{Binding ExportRecordingCommand}"/><Button Content="Aufnahmebibliothek öffnen" Command="{Binding LibraryFolderCommand}"/></WrapPanel><TextBlock Style="{StaticResource Hint}" Text="Vertrauliche Werte sind im Profil und auf dem erzeugten Medium im Klartext enthalten; Listen und Protokolle zeigen sie nicht an. Zugriff auf diese Dateien entsprechend beschränken."/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Bewusste Grenzen der Beta" FontSize="20" Foreground="#FFD88A"/><TextBlock Style="{StaticResource Hint}" Text="Keine Mauskoordinaten, keine UAC-Automatisierung und keine universelle Silent-Erkennung. Nicht zugängliche oder mehrdeutige Steuerelemente führen zu einem Fehler. Die Wiederholung erfolgt nach erster Anmeldung; SYSTEM/specialize hat keinen Benutzerdesktop."/><TextBlock Style="{StaticResource Hint}" Text="Windows Sandbox ist eine externe Windows-Voraussetzung. Netzwerk ist nur für markierte Webinstaller aktiviert. Nur der eigene Sitzungs-Ausgabeordner ist beschreibbar geteilt. Persönliche Verzeichnisse werden nicht freigegeben. Textwerte und Profil vor Übernahme auf vertrauliche Angaben prüfen."/></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem><TabItem Header="04   Setup-Optionen"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding Editing}">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows nach deinen Vorgaben" FontSize="24" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Hint}" Text="Alle Schalter sind optional und werden nur in der neuen ISO wirksam. Die Einstellungen des Erstellungscomputers werden nicht geändert."/>
     <CheckBox Content="Lokalen Benutzer erstellen · ohne Microsoft-Konto" IsChecked="{Binding Setup.CreateLocalUser}"/><StackPanel IsEnabled="{Binding Setup.CreateLocalUser}"><TextBlock Text="Kontoname"/><TextBox Text="{Binding Setup.LocalUserName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Kennwort (mindestens 8 Zeichen)"/><PasswordBox PasswordChanged="LocalPasswordChanged" Background="#0E1628" Foreground="White" BorderBrush="#334361" Padding="10" Margin="0,5,0,10"/><CheckBox Content="Dieses Konto als Administrator anlegen" IsChecked="{Binding Setup.LocalUserAdministrator}"/><TextBlock Style="{StaticResource Hint}" Text="Kennwörter bleiben nur im Arbeitsspeicher und müssen beim Öffnen eines Projekts neu eingegeben werden. Windows benötigt das Kennwort in der ISO-Antwortdatei; Base64 schützt es nicht vor Auslesen. ISO entsprechend vertraulich behandeln. Es wird kein automatisches Login eingerichtet."/></StackPanel>
     <CheckBox Content="„Ich habe kein Internet“ ermöglichen · buildabhängig" IsChecked="{Binding Setup.EnableOfflineButton}"/><TextBlock Style="{StaticResource Hint}" Text="Setzt BypassNRO vor OOBE. Je nach Windows-11-Build kann der Schalter wirkungslos sein, da Microsoft diese Mechanismen entfernt. Ein vorkonfiguriertes lokales Konto nutzt zusätzlich die dokumentierte Antwortdatei. Kein vorgetäuschter Erfolg und keine Garantie für alle Builds."/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows-11-Setupprüfungen" FontSize="20"/><CheckBox Content="TPM-2.0-Prüfung überspringen" IsChecked="{Binding Setup.BypassTpmCheck}"/><CheckBox Content="Secure-Boot-Prüfung überspringen" IsChecked="{Binding Setup.BypassSecureBootCheck}"/><CheckBox Content="Arbeitsspeicherprüfung überspringen" IsChecked="{Binding Setup.BypassRamCheck}"/><TextBlock Style="{StaticResource Hint}" Text="Experimentelle LabConfig-Schalter im Windows-PE-Setup. Sie schalten weder Firmware-Secure-Boot noch Defender ab. CPU-Instruktionsanforderungen wie SSE4.2/POPCNT bleiben bestehen. Microsoft unterstützt Installationen auf ungeeigneter Hardware nicht; mit der jeweiligen ISO in einer VM prüfen."/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Weitere Einrichtung" FontSize="20"/><TextBlock Text="Computername (optional, höchstens 15 Zeichen)" Margin="0,12,0,0"/><TextBox Text="{Binding Setup.ComputerName,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Region und Tastatur vorgeben" IsChecked="{Binding Setup.ConfigureRegion}"/><ComboBox IsEnabled="{Binding Setup.ConfigureRegion}" SelectedValue="{Binding Setup.Region}" SelectedValuePath="Tag"><ComboBoxItem Content="Deutschland · deutsche Tastatur" Tag="de-DE"/><ComboBoxItem Content="Österreich · deutsche Tastatur" Tag="de-AT"/><ComboBoxItem Content="USA · US-Tastatur" Tag="en-US"/></ComboBox><TextBlock Style="{StaticResource Hint}" Text="Ändert die Regionalformate und Tastatur. Die Anzeigesprache der Original-ISO bleibt erhalten; es werden keine Sprachpakete heruntergeladen."/><CheckBox Content="Zeitzone vorgeben" IsChecked="{Binding Setup.ConfigureTimeZone}"/><ComboBox IsEnabled="{Binding Setup.ConfigureTimeZone}" SelectedValue="{Binding Setup.TimeZone}" SelectedValuePath="Tag"><ComboBoxItem Content="Wien / Berlin" Tag="W. Europe Standard Time"/><ComboBoxItem Content="London" Tag="GMT Standard Time"/><ComboBoxItem Content="UTC" Tag="UTC"/><ComboBoxItem Content="New York" Tag="Eastern Standard Time"/></ComboBox><CheckBox Content="OEM-Registrierungsseite überspringen" IsChecked="{Binding Setup.HideOemRegistration}"/><CheckBox Content="Lange Windows-Dateipfade aktivieren" IsChecked="{Binding Setup.EnableLongPaths}"/><TextBlock Style="{StaticResource Hint}" Text="Lange Pfade gelten für Anwendungen, die Windows-Langpfade unterstützen. Keine Änderungen an Windows Update, Aktivierung oder Schutzsoftware."/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Versionen und Downloads" FontSize="20"/><TextBlock Style="{StaticResource Hint}" Text="Nach erfolgreichem Build, Prozess-/UI-Test und EXE-Start wird jede Entwicklungsversion mit Quellcode, EXE und SHA-256 lokal unter %LOCALAPPDATA%\NovaForge\Versions gesichert. Vorherige Versionen bleiben erhalten. ISO-/VM-Abnahme wird getrennt ausgewiesen."/><StackPanel Orientation="Horizontal"><Button Content="Lokale Versionsstände öffnen" Command="{Binding HistoryCommand}"/><Button Content="GitHub-Versionen herunterladen ↗" Command="{Binding ReleasesCommand}"/></StackPanel></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="05   Erstellung"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ein neues Medium erstellen" FontSize="24"/><StackPanel IsEnabled="{Binding Editing}"><TextBlock Text="Ausgabe-ISO" Margin="0,16,0,0"/><DockPanel><Button DockPanel.Dock="Right" Content="Ziel auswählen …" Command="{Binding OutputCommand}"/><TextBox Text="{Binding OutputPath,UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Style="{StaticResource Hint}" Text="{Binding OutputHint}"/><TextBlock Text="Arbeitsverzeichnis"/><DockPanel><Button DockPanel.Dock="Right" Content="Ordner auswählen …" Command="{Binding WorkCommand}"/><TextBox Text="{Binding WorkDirectory,UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Style="{StaticResource Hint}" Text="Ausreichend Platz für ISO-Kopie, Installer und neue ISO einplanen. Bestehende Ausgaben werden nicht überschrieben. Administratorfreigaben gelten nur für das Einbinden/Kopieren und Prüfen der ISO."/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="◈  ISO erstellen" Background="{StaticResource Accent}" Command="{Binding BuildCommand}"/><Button Content="Abbrechen" Command="{Binding CancelCommand}"/><Button Content="Konfiguration prüfen" Command="{Binding ValidateCommand}"/></StackPanel></StackPanel></Border><TextBlock Text="{Binding Activity}" FontWeight="SemiBold" Margin="0,0,0,10"/><ProgressBar Height="8" Minimum="0" Maximum="1" Value="{Binding Fraction}" IsIndeterminate="{Binding Indeterminate}"/><TextBox Text="{Binding Log}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Height="270" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="06   Ergebnis"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding ResultTitle}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding ResultText}" Margin="0,20,0,20"/><TextBlock Text="SHA-256"/><TextBox Text="{Binding ResultHash,Mode=OneWay}" IsReadOnly="True"/><StackPanel Orientation="Horizontal"><Button Content="Ausgabeordner öffnen" Command="{Binding FolderCommand}"/><Button Content="Protokoll öffnen" Command="{Binding LogCommand}"/></StackPanel><TextBlock Style="{StaticResource Hint}" Margin="0,24,0,0" Text="Vor produktiver Nutzung in einer VM testen. Systemprotokolle: C:\Windows\NovaForge\State. Benutzerprotokolle: %LOCALAPPDATA%\NovaForge. Ein erforderlicher Neustart muss nach Setup manuell durchgeführt werden."/></StackPanel></Border></ScrollViewer></TabItem>
  </TabControl></Grid><Border Grid.Row="2" Background="#122B37" CornerRadius="10" Padding="14" Margin="0,18,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="EXPERIMENTELL · BETA" Foreground="#FFD88A" Margin="20,0,0,0"/><TextBlock Text="{Binding Status}"/></DockPanel></Border></Grid></Window>